# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# MobSF reads these from the process environment; it does not load .env itself.
#   Local run:   set -a; source .env; set +a; ./run.sh
#   Docker:      docker compose --env-file ../.env -f docker/docker-compose.yml up
#   CI:          GitHub repo Settings → Secrets and variables → Actions

# --- Core ---------------------------------------------------------------
# Django secret key. Leave empty to auto-generate one in ~/.MobSF/secret
MOBSF_SECRET_KEY=
# REST API key. Leave empty to auto-generate
MOBSF_API_KEY=
MOBSF_DEBUG=0
# Set to 1 only for local testing
MOBSF_DISABLE_AUTHENTICATION=0
MOBSF_ASYNC_ANALYSIS=0

# --- Database (leave POSTGRES_* empty to use SQLite) ---------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=mobsf
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Optional integrations ----------------------------------------------
# WARNING: VT flags are on for ANY non-empty value, including 0.
# Leave empty to disable. MOBSF_VT_UPLOAD sends app binaries to VirusTotal.
MOBSF_VT_ENABLED=
MOBSF_VT_API_KEY=
MOBSF_VT_UPLOAD=

# --- Dynamic analysis (Android emulator first, per Q5) -------------------
MOBSF_ANALYZER_IDENTIFIER=
MOBSF_PROXY_IP=
MOBSF_PROXY_PORT=

# --- Corellium (later, per Q5) ------------------------------------------
MOBSF_CORELLIUM_API_DOMAIN=
MOBSF_CORELLIUM_API_KEY=
MOBSF_CORELLIUM_PROJECT_ID=
